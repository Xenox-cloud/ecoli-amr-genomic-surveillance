tools/
*.zip

# Project data
data/raw/*
data/interim/*
data/processed/*

# Generated outputs
outputs/figures/*
outputs/reports/*
outputs/tables/*

# Logs and temporary files
*.log
*.tmp

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Preserve repository structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!outputs/figures/.gitkeep
!outputs/reports/.gitkeep
!outputs/tables/.gitkeep