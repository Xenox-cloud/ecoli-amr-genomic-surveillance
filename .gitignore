# Virtual environments
venv/
.venv/
venv-py314-backup/

# Python cache and test files
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.coverage
htmlcov/

# Build artifacts
build/
dist/

# Databases
*.db
*.sqlite
*.sqlite3

